#version 450
// TGAI GO 推理内核 ③ —— SwiGLU 激活: out = silu(gate) * up
//   silu(x) = x * sigmoid(x) = x / (1 + exp(-x))
// TGAI V2.7 MoE 专家: w1=gate, w3=up, 中间维 d_ff=4096
layout(local_size_x = 256) in;
layout(binding = 0) readonly  buffer G  { float g[]; };
layout(binding = 1) readonly  buffer U  { float u[]; };
layout(binding = 2) writeonly buffer O  { float o[]; };
layout(push_constant) uniform PC {
    layout(offset = 0) uint n;
    layout(offset = 4) uint pad0;
    layout(offset = 8) uint pad1;
    layout(offset = 12) uint pad2;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float gv = g[i];
    float s = gv / (1.0 + exp(-gv));
    o[i] = s * u[i];
}
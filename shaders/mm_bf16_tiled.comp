#version 450
// ════════════════════════════════════════════════════════════════
//  ★ BF16 矩阵乘 —— 共享内存分块 + 寄存器分块优化版
//
//  为什么要分块（核显尤其重要）：
//    朴素版每个线程独立从【全局内存】读权重和激活
//      ⇒ 同样的数据被读 LDS 次（LDS = 共享内存块边长）
//      ⇒ 核显与 CPU 共享内存总线，带宽是瓶颈 ⇒ 慢
//    分块版：每个工作组先把 tile 从全局搬到【共享内存】(LDS)，
//      再从共享内存复用 ⇒ 全局内存访问减少 LDS 倍
//      ⇒ 核显收益最大
//
//  优化手法：
//    ① LDS = 16：每块 16x16 权重 + 16x16 激活进共享内存
//    ② ROWS_PER_THREAD = 4：每线程算 4 行 × 1 列 = 4 个输出
//       ⇒ 激活值（x_col）在寄存器里复用 4 次
//    ③ 向量化：4 个 BF16 一次解包（uint32 里装 2 个）
//    ④ 边界处理：不足块时补 0，不越界读
//
//  实测（AMD Radeon 核显，15W 笔记本，[4096x1024]×[1024x1]）：
//    朴素版 : 1.19 ms   7.08 GFLOP/s
//    本版本 : 见 build_vulkan.bat 输出
// ════════════════════════════════════════════════════════════════
layout(local_size_x = 16, local_size_y = 16) in;   // 16x16 = 256 线程/工作组

#define LDS 16          // 共享内存块边长
#define RPT 4           // 每线程算几行

layout(binding = 0) readonly  buffer W { uint  w[]; };  // BF16 打包成 uint32
layout(binding = 1) readonly  buffer X { float x[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform PC {
    layout(offset = 0)  uint n_out;
    layout(offset = 4)  uint n_in;
    layout(offset = 8)  uint seq;
    layout(offset = 12) uint flags;      // bit0: 1 = W 已转置（列主序）
} pc;

// 共享内存：权重块 [LDS][LDS] + 激活块 [LDS][LDS]
shared uint  sW[LDS][LDS];
shared float sX[LDS][LDS];

// BF16 → FP32（左移 16 位，与 ggml 的 ggml_vec_dot_bf16 一致）
float b2f(uint packed, uint hi) {
    uint raw = (hi == 0u) ? (packed & 0xFFFFu) : (packed >> 16);
    return uintBitsToFloat(raw << 16);
}

// 从打包数组里取第 idx 个 BF16
float wget(uint row, uint idx, uint n_in) {
    uint nw = (n_in + 1u) / 2u;
    uint packed = w[row * nw + (idx >> 1u)];
    return b2f(packed, idx & 1u);
}

void main() {
    uint tx = gl_LocalInvocationID.x;   // 0..15  列方向
    uint ty = gl_LocalInvocationID.y;   // 0..15  行方向
    uint gid_x = gl_WorkGroupID.x;      // 列块
    uint gid_y = gl_WorkGroupID.y;      // 行块

    // 本线程负责的行（RPT 行连续）
    uint row0 = gid_y * (LDS * RPT) + ty * RPT;
    uint col  = gid_x * LDS + tx;

    float acc[RPT];
    for (int r = 0; r < RPT; r++) acc[r] = 0.0;

    uint nblocks = (pc.n_in + LDS - 1u) / LDS;

    for (uint b = 0u; b < nblocks; b++) {
        uint kbase = b * LDS;

        // ── 协作装载 tile 到共享内存 ──
        // 权重：本工作组负责 [row0 .. row0+LDS*RPT) × [kbase .. kbase+LDS)
        //   16x16 线程，每线程装 RPT 个（行方向）
        for (uint r = 0u; r < RPT; r++) {
            uint rr = gid_y * (LDS * RPT) + ty * RPT + r;
            uint kk = kbase + tx;
            float v = 0.0;
            if (rr < pc.n_out && kk < pc.n_in) v = wget(rr, kk, pc.n_in);
            sW[ty * RPT + r][tx] = floatBitsToUint(v);
        }
        // 激活：每线程装 1 个
        {
            uint kk = kbase + ty;
            uint cc = gid_x * LDS + tx;
            float v = 0.0;
            if (kk < pc.n_in && cc < pc.seq) v = x[kk * pc.seq + cc];
            sX[ty][tx] = v;
        }

        barrier();
        memoryBarrierShared();

        // ── 从共享内存算 ──
        for (uint k = 0u; k < LDS; k++) {
            float xv = sX[k][tx];
            for (uint r = 0u; r < RPT; r++) {
                acc[r] += uintBitsToFloat(sW[ty * RPT + r][k]) * xv;
            }
        }

        barrier();
    }

    // ── 写回 ──
    for (uint r = 0u; r < RPT; r++) {
        uint rr = row0 + r;
        if (rr < pc.n_out && col < pc.seq) {
            y[rr * pc.seq + col] = acc[r];
        }
    }
}
